# Canonical full-PREP integration contract.  This is one conservative
# integration/ranking checkpoint selected before physical results, not a Tmin
# point.  The 40 ns target is the next 5 ns grid point above 1.25x the largest
# 15 ns-preflight mapped arrival.  The 620x620 um core holds the diagnostic
# V36 mapped area at about 36.7% utilization before CTS/repair, below the fixed
# 45% placement density while avoiding an unnecessarily sparse floorplan.
CLOCK_PERIOD=40.0
ABC_DELAY_PS=40000
PHYSICAL_SEED=1
DRT_OR_K=1.0
PLACE_DENSITY=0.45
FLOORPLAN_STATUS=frozen
DIE_AREA="0 0 640 640"
CORE_AREA="10 10 630 630"
